# Combined reference of every environment variable used by AgentCare — union of
# backend/.env.example and frontend/.env.example.
#
# This file is NOT read automatically by either process: backend/app/config.py
# loads backend/.env and the frontend loads frontend/.env, each relative to its
# own process, not the repo root. Copy the relevant variables below into
# backend/.env and frontend/.env respectively (or just `cp` each subfolder's own
# .env.example — this file only exists so every variable is visible in one place).

# ============================== backend/.env ===============================

# --- Database ---
# SQLite for local dev (file-based, persists across restarts).
# Swap to a PostgreSQL URL (e.g. postgresql+psycopg2://user:pass@host:5432/dbname)
# to move to Postgres without any code changes.
DATABASE_URL=sqlite:///./agentcare.db

# --- Auth / JWT ---
# Generate a real secret for any non-local deployment, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-secret-never-commit-a-real-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- LLM / Agent configuration ---
# Model name is read from env so it's swappable without code changes.
# Default assumes Google ADK's native Gemini integration.
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash

# Set to "true" to use ADK's LiteLLM path against a different provider instead of
# native Gemini. If true, LLM_MODEL below is passed to LiteLlm(...) as the model id.
USE_LITELLM=false
LLM_MODEL=gemini/gemini-3.5-flash

# --- File storage ---
# Absolute or relative path OUTSIDE any web-servable static directory.
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_UPLOAD_SIZE_MB=10

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:8501,http://localhost:8000

# ============================== frontend/.env ===============================

# URL of the AgentCare backend API (must be running separately).
BACKEND_API_URL=http://localhost:8000 # Override this with the actual backend URL in production.

# Set to true when serving over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false
